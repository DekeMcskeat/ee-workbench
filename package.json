{
  "name": "ee-workbench",
  "version": "0.3.1",
  "description": "Electrical Engineering Workbench — NEC-based calculation kernel (voltage drop, conductor sizing, conduit fill, load calc, transformer sizing, PF correction) with a full audit trail and a strict no-fabrication policy on table data.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ui": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
